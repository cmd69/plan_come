# ============================================
# PlanCome — Variables de entorno
# ============================================

# Base de datos SQLite (ruta dentro del contenedor)
DATABASE_URL=file:/data/plancome.db

# Next.js
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# Puerto (configurable)
APP_PORT=3040

# Auth (single user)
AUTH_USER=admin
AUTH_PASSWORD=admin
AUTH_SECRET=cambiar-este-secreto-en-produccion
