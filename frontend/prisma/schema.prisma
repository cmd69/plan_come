generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DishType {
  COMIDA
  CENA
  MIXTO
  ACOMPANANTE
}

// ProductCategory eliminado — ahora dinámico en tabla Category

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum MealType {
  COMIDA
  CENA
}

// ─── Categorías de productos ──────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  label     String
  emoji     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Inventario / Lista maestra ───────────────────────────────────────────────

// Un Product representa tanto una entrada del inventario (con unidades)
// como un artículo de la lista maestra de compra.
model Product {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String?
  category  String
  units     Int      @default(0)
  createdAt DateTime @default(now())

  dishIngredients      DishIngredient[]
  shoppingSessionItems ShoppingSessionItem[]
}

// ─── Catálogo de platos ───────────────────────────────────────────────────────

model Dish {
  id        Int      @id @default(autoincrement())
  name      String
  type      DishType @default(MIXTO)
  emoji     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  planSlots   PlanSlot[]
  ingredients DishIngredient[]
  sides       DishSide[]       @relation("DishSides")
  sideOf      DishSide[]       @relation("SideOf")
}

// Acompañante de un plato: enlaza un plato principal con un plato acompañante.
// Siempre en grupos: group="A" → alternativa dentro del grupo (groupMin del grupo debe estar disponible)
model DishSide {
  id       Int     @id @default(autoincrement())
  dishId   Int
  dish     Dish    @relation("DishSides", fields: [dishId], references: [id], onDelete: Cascade)
  sideId   Int
  side     Dish    @relation("SideOf", fields: [sideId], references: [id], onDelete: Cascade)
  group    String?
  groupMin Int     @default(1)

  @@unique([dishId, sideId])
}

// Ingrediente de un plato: producto, cantidad necesaria y si es opcional.
// - optional=true → no afecta disponibilidad
// - group=null → ingrediente obligatorio individual (debe tener stock)
// - group="CARNE" → alternativa dentro del grupo (al menos 1 del grupo debe tener stock)
model DishIngredient {
  id        Int     @id @default(autoincrement())
  dishId    Int
  dish      Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  optional  Boolean @default(false)
  group     String?
  groupMin  Int     @default(1)

  @@unique([dishId, productId])
}

// ─── Plan semanal ─────────────────────────────────────────────────────────────

// Un WeekPlan por semana; weekStart = lunes de esa semana (sin hora).
model WeekPlan {
  id        Int      @id @default(autoincrement())
  weekStart DateTime @unique
  createdAt DateTime @default(now())

  slots PlanSlot[]
}

// Cada slot es único por semana + día + tipo de comida.
model PlanSlot {
  id         Int       @id @default(autoincrement())
  weekPlanId Int
  weekPlan   WeekPlan  @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  day        DayOfWeek
  meal       MealType
  dishId     Int?
  dish       Dish?     @relation(fields: [dishId], references: [id], onDelete: SetNull)
  eatenOut   Boolean   @default(false)

  @@unique([weekPlanId, day, meal])
}

// ─── Compra ───────────────────────────────────────────────────────────────────

// Una sesión de compra: se crea al "preparar compra", se completa al volver del super.
model ShoppingSession {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  items ShoppingSessionItem[]
}

// Cada ítem de la sesión: qué producto, cuántas unidades comprar, y si ya está cogido.
model ShoppingSessionItem {
  id            Int             @id @default(autoincrement())
  sessionId     Int
  session       ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product         @relation(fields: [productId], references: [id])
  quantityToBuy Int             @default(1)
  checked       Boolean         @default(false)

  @@unique([sessionId, productId])
}
